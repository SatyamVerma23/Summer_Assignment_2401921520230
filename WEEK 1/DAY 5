Valid Palindrome
// Remove non-alphanumeric and compare
class Solution {
public:
    bool isPalindrome(string s) {
        string t = "";

        for(char c : s) {
            if(isalnum(c))
                t += tolower(c);
        }

        int l = 0, r = t.size() - 1;

        while(l < r) {
            if(t[l] != t[r])
                return false;
            l++;
            r--;
        }

        return true;
    }
};
14. Reverse String
// Swap from both ends
class Solution {
public:
    void reverseString(vector<char>& s) {
        int l = 0, r = s.size() - 1;

        while(l < r) {
            swap(s[l], s[r]);
            l++;
            r--;
        }
    }
};
15. Longest Common Prefix
// Reduce prefix step by step
class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        if(strs.empty()) return "";

        string prefix = strs[0];

        for(int i = 1; i < strs.size(); i++) {
            while(strs[i].find(prefix) != 0) {
                prefix = prefix.substr(0, prefix.size()-1);
                if(prefix == "") return "";
            }
        }

        return prefix;
    }
};
