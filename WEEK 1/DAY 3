Move Zeroes
// j tracks position of non-zero elements
class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int j = 0;

        for(int i = 0; i < nums.size(); i++) {
            if(nums[i] != 0) {
                swap(nums[i], nums[j]);
                j++;
            }
        }
    }
};
8. Squares of a Sorted Array
// Two pointer from both ends
class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        int n = nums.size();
        vector<int> res(n);

        int l = 0, r = n - 1, pos = n - 1;

        while(l <= r) {
            if(abs(nums[l]) > abs(nums[r])) {
                res[pos--] = nums[l] * nums[l];
                l++;
            } else {
                res[pos--] = nums[r] * nums[r];
                r--;
            }
        }

        return res;
    }
};
9. Container With Most Water
// Two pointer approach: maximize area
class Solution {
public:
    int maxArea(vector<int>& height) {
        int l = 0, r = height.size() - 1;
        int best = 0;

        while(l < r) {
            int area = min(height[l], height[r]) * (r - l);
            best = max(best, area);

            if(height[l] < height[r])
                l++;
            else
                r--;
        }

        return best;
    }
};
